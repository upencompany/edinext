# Canonical site URL (read at build time)
NEXT_PUBLIC_SITE_URL=https://edinext.it

# Indexing is enabled automatically on Vercel production (VERCEL_ENV=production).
# Set to true to allow indexing when hosting elsewhere.
ALLOW_INDEXING=

# Contact form delivery: POST JSON endpoint (mail relay, ticketing, automation)
CONTACT_WEBHOOK_URL=

# Optional: HMAC-SHA256 key, sent as X-Edinext-Signature: sha256=<hex>
CONTACT_WEBHOOK_SECRET=
